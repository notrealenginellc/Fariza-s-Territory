# Fariza's Territory — Environment Configuration Template
# Canonical Runtime: Persistent Node.js + Express (server.js) + Managed Supabase PostgreSQL

# Server & Canonical Origin
PORT=3000
NODE_ENV=production
PUBLIC_SITE_URL=https://farizasterritory.com
# Optional comma-separated extra browser origins allowed for /api/capi CORS
ALLOWED_ORIGINS=https://farizasterritory.com

# Supabase Configuration (https://vjbhrdclcnxevunskodm.supabase.co)
SUPABASE_URL=https://vjbhrdclcnxevunskodm.supabase.co
SUPABASE_ANON_KEY=
# SERVER-ONLY SECRET: Never expose SUPABASE_SERVICE_ROLE_KEY in client JS or browser storage
SUPABASE_SERVICE_ROLE_KEY=

# Optional comma-separated fallback allowlist of verified staff emails (in addition to public.staff_users)
ADMIN_ALLOWED_EMAILS=

# Optional standalone Admin credentials when Supabase is not yet connected
# (If omitted and Supabase is unconfigured, /admin offers a one-time First-Run Owner Setup form)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Meta Pixel & Server-Side Conversions API (CAPI)
META_DATASET_ID=1657670575734647
META_PIXEL_ID=1657670575734647
# SERVER-ONLY SECRET: Required for live CAPI dispatch
META_CAPI_ACCESS_TOKEN=
# Leave blank in production so events optimize live conversions
META_TEST_EVENT_CODE=
